{% if invoiceType == 'REGULAR' %}

    {% set currInvoice = ent_Order.invoiceRegular %}

{% elseif invoiceType == 'PROFORMA' %}

    {% set currInvoice = ent_Order.invoiceProforma %}

{% elseif invoiceType == 'ADVANCE' %}

    {% set currInvoice = ent_InvoiceAdvance %}

{% elseif invoiceType == 'FINAL' %}

    {% set currInvoice = ent_Order.invoiceFinal %}
    
{% endif %}

{% set showPaymentDetails = invoiceType == 'REGULAR' or (invoiceType == 'PROFORMA' and currInvoice.payable) or invoiceType == 'ADVANCE' or invoiceType == 'FINAL' %}

{% if invoiceType == 'FINAL' %}
    {% set items = ent_Order.items %}
    {% set currency = ent_Order.currency %}
    {% set totalsEntity = ent_Order %}
    {% set paymentMode = ent_Order.paymentMode %}
{% else %}
    {% set items = currInvoice.items %}
    {% set currency = currInvoice.currency %}
    {% set totalsEntity = currInvoice %}
    {% set paymentMode = currInvoice.paymentMode %}
{% endif %}


<html>
<head>
	<meta charset="UTF-8">	
	{# <link rel="stylesheet" href="{{ assetsDir }}/css/pdf/whatever.css"> #}
</head>

<body>

	<div class="header">
	 	<h1>
            {% if invoiceType == 'PROFORMA' %}
                PROFORMA
            {% elseif invoiceType == 'ADVANCE' %}
                ADVANCE PAYMENT
            {% endif %} 
            
            INVOICE - reference number: {{ currInvoice.referenceNumber }}
	 	</h1>
	</div>

	<table class="seller-buyer-detail">
    	
    	<tr class="seller-buyer">
    		<td class="seller">
            	
            	<h3>Seller</h3>
            	<div class="address">
                    {{ ent_Order.seller.organization }}
                	<br>{{ ent_Order.seller.streetAddress1 }}
                	<br>{{ ent_Order.seller.postcode }} {{ ent_Order.seller.city }}
                	{% if ent_Order.seller.companyIdentificationNumber is not empty %}<br>CIN: {{ ent_Order.seller.companyIdentificationNumber }}{% endif %}
                	{% if ent_Order.seller.vatIdentificationNumber is not empty %}<br>VIN: {{ ent_Order.seller.vatIdentificationNumber }}{% endif %}
                    {% if ent_Order.seller.legalEntityRegistrationDetails is not empty %}<br>{{ ent_Order.seller.legalEntityRegistrationDetails }}{% endif %}
            	</div>

        	</td> 
        	<td class="buyer">
            	
            	<h3>Buyer</h3>
            	<div class="address">
					{{ ent_Order.buyer.fullName }}
                	<br>{{ ent_Order.buyer.streetAddress1 }}
                	<br>{{ ent_Order.buyer.postcode }} {{ ent_Order.buyer.city }}
                	{% if ent_Order.buyer.companyIdentificationNumber is not empty %}<br>CIN: {{ ent_Order.buyer.companyIdentificationNumber }}{% endif %}
                	{% if ent_Order.buyer.vatIdentificationNumber is not empty %}<br>VIN: {{ ent_Order.buyer.vatIdentificationNumber }}{% endif %}
            	</div>
				
        	</td>
        </tr>
	
		<tr>        	
        	<td colspan="2">
        	
        		<table class="detail">
        			
                    {% if showPaymentDetails %}

                        <tr>
                            <td>Payment mode</td>
                            <td>
                                {% if paymentMode.value == 1 %}
                                    regular bank transfer
                                {% elseif paymentMode.value == 2 %}
                                    on-line bank transfer
                                {% elseif paymentMode.value == 3 %}
                                    credit card
                                {% endif %}
                            </td>
                        </tr>

                        {% if paymentMode.value == 1 %}
                            <tr>
                                <td>Bank account</td>
                                <td>{{ ent_Order.paymentModeBankAccount }}</td>
                            </tr>
                        {% endif %}
                        
                        <tr>
                    		<td>Payment reference number</td>
                        	<td>{{ currInvoice.paymentReference }}</td>
                        </tr>

                    {% endif %}
                    
            		<tr>
                		<td>Issued at</td>
                    	<td>{{ currInvoice.createdAt|format_datetime(pattern="d. MMMM y") }}</td>
                    </tr>
                    
                    {% if showPaymentDetails %}
                        <tr>
                    		<td>Due date</td>
                        	<td>{{ currInvoice.dueDate|format_datetime(pattern="d. MMMM y") }}</td>
                        </tr>
        		    {% endif %}
                    
                    {# Notice to avoid misuse #}
                    {% if invoiceType == 'PROFORMA' %}
                        <tr>
                            <td colspan="2">
                            {% if currInvoice.payable %}
                                Payment accepted against this proforma. A deposit (tax) invoice or receipt will be issued on payment.
                            {% else %}
                                <strong>Note:</strong> This document is a proforma (estimate) and <em>not</em> a tax invoice. Payment should only be made when a deposit/tax invoice is issued.
                            {% endif %}
                            </td>
                        </tr>
                    {% endif %}

            	</table>
            	
        	</td>
    	</tr>
	
	</table>
	
	
    <table class="items">
        <thead>
            <tr>
                <th class="amount">Amount</th>
                <th class="short-description">Short description</th>
                <th class="price-vat-excluded">Price (VAT excl.)</th>
                <th>VAT rate</th>
                <th>VAT total</th>
                <th>Total (VAT incl.)</th>
            </tr>
        </thead>

        <tbody>
            {% for item in items %}
                <tr class="item">
                    <td class="amount">{{ item.amount }}</td>
                    <td class="short-description">
                        {{ item.name }}<br>
                        {{ item.shortDescription }}
                    </td>
                    <td class="price-vat-excluded">{{ item.priceVatExcluded|format_currency(currency) }}</td>
                    <td>{{ item.vatRate }}%</td>
                    <td>{{ item.vat|format_currency(currency) }}</td>
                    <td>{{ item.priceVatIncluded|format_currency(currency) }}</td>
                </tr>
            {% endfor %}

            {% if invoiceType == 'FINAL' %}
                <tr class="final_subtotal">
                    <td></td>
                    <td>Subtotal (full contract value)</td>
                    <td>{{ totalsEntity.priceVatExcluded|format_currency(currency) }}</td>
                    <td></td>
                    <td>{{ totalsEntity.priceVat|format_currency(currency) }}</td>
                    <td>{{ totalsEntity.priceVatIncluded|format_currency(currency) }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    {% if invoiceType != 'FINAL' %}
        
        <table class="totals">
            <thead>
                <tr>
                    <th>Total (VAT excl.)</th>
                    <th>Total (VAT incl.)</th>
                    {% if invoiceType != 'PROFORMA' %}
                        <th>VAT base</th>
                        <th>VAT total</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ totalsEntity.priceVatExcluded|format_currency(currency) }}</td>
                    <td>{{ totalsEntity.priceVatIncluded|format_currency(currency) }}</td>

                    {% if invoiceType != 'PROFORMA' %}
                        <td>{{ totalsEntity.priceVatBase|format_currency(currency) }}</td>
                        <td>{{ totalsEntity.priceVat|format_currency(currency) }}</td>
                    {% endif %}
                </tr>
            </tbody>
        </table>

    {% elseif invoiceType == 'FINAL' %}

        {% if ent_Order.invoicesAdvance is not empty %}
            <h4>Advance invoices</h4>

            {% set advancesTotals = ent_Order|invoices_advance_totals %}

            <table class="advances">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Date</th>
                        <th>Amount (VAT excl.)</th>
                        <th>VAT</th>
                        <th>Amount (incl. VAT)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for adv in ent_Order.invoicesAdvance %}
                        <tr>
                            <td>{{ adv.referenceNumber }}</td>
                            <td>{{ adv.createdAt|format_datetime(pattern="d. MMMM y") }}</td>
                            <td>{{ adv.priceVatExcluded|format_currency(currency) }}</td>
                            <td>{{ adv.priceVat|format_currency(currency) }}</td>
                            <td>{{ adv.priceVatIncluded|format_currency(currency) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="2">Total deposits</th>
                        <th>{{ advancesTotals.vatExcluded|format_currency(currency) }}</th>
                        <th>{{ advancesTotals.vat|format_currency(currency) }}</th>
                        <th>{{ advancesTotals.vatIncluded|format_currency(currency) }}</th>
                    </tr>
                </tfoot>
            </table>

            {# Remaining / amount due calculation #}
            {% set remaining_net = (ent_Order.priceVatExcluded - advancesTotals.vatExcluded) %}
            {% set remaining_vat = (ent_Order.priceVat - advancesTotals.vat) %}
            {% set remaining_incl = (ent_Order.priceVatIncluded - advancesTotals.vatIncluded) %}

            <table class="remaining">
                <tr>
                    <th>Net remaining (VAT excl.)</th>
                    <td>{{ remaining_net|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <th>Remaining VAT</th>
                    <td>{{ remaining_vat|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <th>Total amount due (incl. VAT)</th>
                    <td>
                        {% if remaining_incl < 0 %}
                            <span class="credit">Credit due to customer: {{ (remaining_incl * -1)|format_currency(currency) }}</span>
                        {% else %}
                            {{ remaining_incl|format_currency(currency) }}
                        {% endif %}
                    </td>
                </tr>
            </table>

        {% elseif ent_Order.invoiceProforma is not empty and ent_Order.invoiceProforma.payable %}

            {% set invProforma = ent_Order.invoiceProforma %}

            {# Remaining / amount due calculation #}
            {% set remaining_net = (ent_Order.priceVatExcluded - invProforma.priceVatExcluded) %}
            {% set remaining_vat = (ent_Order.priceVat - invProforma.priceVat) %}
            {% set remaining_incl = (ent_Order.priceVatIncluded - invProforma.priceVatIncluded) %}

            <table class="remaining">
                <tr>
                    <th>Payment received via Proforma [{{ invProforma.createdAt|format_datetime(pattern="d. MMMM y") }}]</th>
                    <td>- {{ invProforma.priceVatIncluded|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <th>Net remaining (VAT excl.)</th>
                    <td>{{ remaining_net|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <th>Remaining VAT</th>
                    <td>{{ remaining_vat|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <th>Total amount due (incl. VAT)</th>
                    <td>
                        {% if remaining_incl < 0 %}
                            <span class="credit">Credit due to customer: {{ (remaining_incl * -1)|format_currency(currency) }}</span>
                        {% else %}
                            {{ remaining_incl|format_currency(currency) }}
                        {% endif %}
                    </td>
                </tr>
            </table>
        {% endif %}

    {% endif %}	

</body>
</html>