{% if invoiceType == 'REGULAR' %}

    {% set currInvoice = order.invoiceRegular %}

{% elseif invoiceType == 'PROFORMA' %}

    {% set currInvoice = order.invoiceProforma %}

{% elseif invoiceType == 'ADVANCE' %}

    {% set currInvoice = invoiceAdvance %}

{% elseif invoiceType == 'FINAL' %}

    {% set currInvoice = order.invoiceFinal %}
    
{% endif %}

{% set showPaymentDetails = invoiceType == 'REGULAR' or (invoiceType == 'PROFORMA' and currInvoice.payable) or invoiceType == 'ADVANCE' or invoiceType == 'FINAL' %}

{% if invoiceType == 'FINAL' %}
    {% set items = order.items %}
    {% set currency = order.currency %}
    {% set totalsEntity = order %}
    {% set paymentMode = order.paymentMode %}
{% else %}
    {% set items = currInvoice.items %}
    {% set currency = currInvoice.currency %}
    {% set totalsEntity = currInvoice %}
    {% set paymentMode = currInvoice.paymentMode %}
{% endif %}


<html>
<head>
	<meta charset="UTF-8">
</head>

<body>

	<div class="header">
	 	<h1 class="header_heading">
            {% if invoiceType == 'PROFORMA' %}
                PROFORMA
            {% elseif invoiceType == 'ADVANCE' %}
                DEPOSIT
            {% endif %} 
            
            INVOICE - reference number: {{ currInvoice.referenceNumber }}
	 	</h1>
	</div>

	<table class="seller_buyer_detail">
    	
    	<tr class="seller_buyer">
    		<td class="seller">
            	
            	<h3>Seller</h3>
            	<div class="seller_address">
                    {{ order.seller.organization }}
                	<br>{{ order.seller.streetAddress1 }}
                	<br>{{ order.seller.postcode }} {{ order.seller.city }}
                	{% if order.seller.companyIdentificationNumber is not empty %}<br>CIN: {{ order.seller.companyIdentificationNumber }}{% endif %}
                	{% if order.seller.vatIdentificationNumber is not empty %}<br>VIN: {{ order.seller.vatIdentificationNumber }}{% endif %}
                    {% if order.seller.legalEntityRegistrationDetails is not empty %}<br>{{ order.seller.legalEntityRegistrationDetails }}{% endif %}
            	</div>

        	</td> 
        	<td class="buyer">
            	
            	<h3>Buyer</h3>
            	<div class="buyer_address">
					{{ order.buyer.fullName }}
                	<br>{{ order.buyer.streetAddress1 }}
                	<br>{{ order.buyer.postcode }} {{ order.buyer.city }}
                	{% if order.buyer.companyIdentificationNumber is not empty %}<br>CIN: {{ order.buyer.companyIdentificationNumber }}{% endif %}
                	{% if order.buyer.vatIdentificationNumber is not empty %}<br>VIN: {{ order.buyer.vatIdentificationNumber }}{% endif %}
            	</div>
				
        	</td>
        </tr>
	
		<tr>        	
        	<td colspan="2">
        	
        		<table class="detail">
        			
                    {% if showPaymentDetails %}

                        <tr>
                            <td class="label">Payment mode</td>
                            <td>
                                {% if paymentMode.value == 1 %}
                                    regular bank transfer
                                {% elseif paymentMode.value == 2 %}
                                    on-line bank transfer
                                {% elseif paymentMode.value == 3 %}
                                    credit card
                                {% endif %}
                            </td>
                        </tr>

                        {% if paymentMode.value == 1 %}
                            <tr>
                                <td class="label">Bank account</td>
                                <td>{{ order.paymentModeBankAccount }}</td>
                            </tr>
                        {% endif %}
                        
                        <tr>
                    		<td class="label">Payment reference number</td>
                        	<td>{{ currInvoice.paymentReference }}</td>
                        </tr>

                    {% endif %}
                    
            		<tr>
                		<td class="label">Issued at</td>
                    	<td>{{ currInvoice.createdAt|format_datetime(pattern="d. MMMM y") }}</td>
                    </tr>
                    
                    {% if showPaymentDetails %}
                        <tr>
                    		<td class="label">Due date</td>
                        	<td>{{ currInvoice.dueDate|format_datetime(pattern="d. MMMM y") }}</td>
                        </tr>
        		    {% endif %}
                    
                    {# Notice to avoid misuse #}
                    {% if invoiceType == 'PROFORMA' %}
                        <tr>
                            <td colspan="2">
                            {% if currInvoice.payable %}
                                Payment accepted against this proforma. A deposit (tax) invoice or receipt will be issued on payment.
                            {% else %}
                                <strong>Note:</strong> This document is a proforma (estimate) and <em>not</em> a tax invoice. Payment should only be made when a deposit/tax invoice is issued.
                            {% endif %}
                            </td>
                        </tr>
                    {% endif %}

            	</table>
            	
        	</td>
    	</tr>
	
	</table>
	
	
    <table class="items">
        <thead>
            <tr class="items_heading">
                <th class="amount">Amount</th>
                <th class="short_description">Short description</th>
                <th class="price_vat_excluded">Price (VAT excl.)</th>
                <th>VAT rate</th>
                {% if invoiceType != 'PROFORMA' %}<th>VAT</th>{% endif %}
                <th>Total (VAT incl.)</th>
            </tr>
        </thead>

        <tbody>
            {% for item in items %}
                <tr class="item">
                    <td class="amount">{{ item.amount }}</td>
                    <td class="short_description">
                        {{ item.name }}<br>
                        {{ item.shortDescription }}
                    </td>
                    <td class="price_vat_excluded">{{ item.priceVatExcluded|format_currency(currency) }}</td>
                    <td>{{ item.vatRate }}%</td>
                    {% if invoiceType != 'PROFORMA' %}<td>{{ item.vat|format_currency(currency) }}</td>{% endif %}
                    <td>{{ item.priceVatIncluded|format_currency(currency) }}</td>
                </tr>
            {% endfor %}

            {% if invoiceType == 'FINAL' %}
                <tr>
                    <td class="final_subtotal"></td>
                    <td class="final_subtotal">Subtotal</td>
                    <td class="final_subtotal">{{ totalsEntity.priceVatExcluded|format_currency(currency) }}</td>
                    <td class="final_subtotal"></td>
                    <td class="final_subtotal">{{ totalsEntity.priceVat|format_currency(currency) }}</td>
                    <td class="final_subtotal">{{ totalsEntity.priceVatIncluded|format_currency(currency) }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    {% if invoiceType != 'FINAL' %}

        <table class="totals">
          
            <tbody>
                <tr>
                    <td class="label">Total (VAT excl.)</td>
                    <td>{{ totalsEntity.priceVatExcluded|format_currency(currency) }}</td>
                </tr>

                {% if invoiceType != 'PROFORMA' %}
                    <tr>
                        <td class="label">VAT base</td>
                        <td>{{ totalsEntity.priceVatBase|format_currency(currency) }}</td>
                    </tr>
                    <tr>
                        <td class="label">VAT total</td>
                        <td>{{ totalsEntity.priceVat|format_currency(currency) }}</td>
                    </tr>
                {% endif %}

                <tr>
                    <td class="total_vat_incl_desc label">Total (VAT incl.)</td>
                    <td class="total_vat_incl">{{ totalsEntity.priceVatIncluded|format_currency(currency) }}</td>
                </tr>
            </tbody>
        </table>

    {% elseif invoiceType == 'FINAL' %}

        {% if order.invoicesAdvance is not empty %}
            <h4 class="advance_invoices_heading">Deposits</h4>

            {% set advancesTotals = order|invoices_advance_totals %}

            <table class="advances">
                <thead>
                    <tr class="advances_heading">
                        <th class="reference">Reference</th>
                        <th class="date">Date</th>
                        <th>Amount (VAT excl.)</th>
                        <th>VAT</th>
                        <th>Amount (incl. VAT)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for adv in order.invoicesAdvance %}
                        <tr>
                            <td class="reference">{{ adv.referenceNumber }}</td>
                            <td class="date">{{ adv.createdAt|format_datetime(pattern="d. MMMM y") }}</td>
                            <td>{{ adv.priceVatExcluded|format_currency(currency) }}</td>
                            <td>{{ adv.priceVat|format_currency(currency) }}</td>
                            <td>{{ adv.priceVatIncluded|format_currency(currency) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" class="advances_total_deposits">Total deposits</td>
                        <td class="advances_total_deposits">{{ advancesTotals.vatExcluded|format_currency(currency) }}</td>
                        <td class="advances_total_deposits">{{ advancesTotals.vat|format_currency(currency) }}</td>
                        <td class="advances_total_deposits">{{ advancesTotals.vatIncluded|format_currency(currency) }}</td>
                    </tr>
                </tfoot>
            </table>

            {# Remaining / amount due calculation #}
            {% set remaining_net = (order.priceVatExcluded - advancesTotals.vatExcluded) %}
            {% set remaining_vat = (order.priceVat - advancesTotals.vat) %}
            {% set remaining_incl = (order.priceVatIncluded - advancesTotals.vatIncluded) %}

            <table class="remaining">
                <tr>
                    <td class="label">Net remaining (VAT excl.)</td>
                    <td>{{ remaining_net|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <td class="label">Remaining VAT</td>
                    <td>{{ remaining_vat|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <td class="total_amount_due_desc label">Total amount due (incl. VAT)</td>
                    <td class="total_amount_due">
                        {% if remaining_incl < 0 %}
                            <span class="credit">Credit due to customer:<br> {{ (remaining_incl * -1)|format_currency(currency) }}</span>
                        {% else %}
                            {{ remaining_incl|format_currency(currency) }}
                        {% endif %}
                    </td>
                </tr>
            </table>

        {% elseif order.invoiceProforma is not empty and order.invoiceProforma.payable %}

            {% set invProforma = order.invoiceProforma %}

            {# Remaining / amount due calculation #}
            {% set remaining_net = (order.priceVatExcluded - invProforma.priceVatExcluded) %}
            {% set remaining_vat = (order.priceVat - invProforma.priceVat) %}
            {% set remaining_incl = (order.priceVatIncluded - invProforma.priceVatIncluded) %}

            <table class="remaining">
                <tr>
                    <td class="label">Payment received via Proforma [{{ invProforma.createdAt|format_datetime(pattern="d. MMMM y") }}]</td>
                    <td>- {{ invProforma.priceVatIncluded|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <td class="label">Net remaining (VAT excl.)</td>
                    <td>{{ remaining_net|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <td class="label">Remaining VAT</td>
                    <td>{{ remaining_vat|format_currency(currency) }}</td>
                </tr>
                <tr>
                    <td class="total_amount_due_desc label">Total amount due (incl. VAT)</td>
                    <td class="total_amount_due">
                        {% if remaining_incl < 0 %}
                            <span class="credit">Credit due to customer:<br> {{ (remaining_incl * -1)|format_currency(currency) }}</span>
                        {% else %}
                            {{ remaining_incl|format_currency(currency) }}
                        {% endif %}
                    </td>
                </tr>
            </table>
        {% endif %}

    {% endif %}	

</body>
</html>