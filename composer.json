{
    "name": "psys/order-invoice-bundle",
    "description": "Order & invoice management for Symfony, ideal for SaaS, services, and digital products.",
    "type": "symfony-bundle",
    "keywords": 
    [
        "symfony",
        "symfony-bundle",
        "digital-products-billing",
        "services-billing",
        "saas-billing",
        "invoicing",        
        "order",
        "invoice",
        "invoice-pdf",
        "pdf-export",
        "pdf-generation",
        "invoice-generation",
        "order-management",
        "invoice-management",
        "proforma-invoice",
        "advance-invoice",
        "deposit-invoice",
        "regular-invoice",
        "final-invoice",
        "file-management"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Psys\\OrderInvoiceBundle\\": "src/"
        }
    },
    "authors": [
        {
            "name": "David Petrásek",
            "email": "davidpetrasek@hotmail.cz"
        }
    ],
    "minimum-stability": "stable",
    "require": 
    {
        "php": ">=8.2",
        "doctrine/orm": ">=3.3",
        "doctrine/doctrine-bundle": ">=2.14",
        "symfony/console": ">=7.2",
        "symfony/finder": ">=7.2",
        "symfony/string": ">=7.2",
        "symfony/filesystem": ">=7.2",
        "symfony/maker-bundle": ">=1.63.0",
        "psys/utils": ">=1.0.10",
        "symfony/yaml": ">=7.2",
        "symfony/mime": ">=7.2",
        "symfony/routing": ">=7.2",
        "doctrine/doctrine-migrations-bundle": ">=3.7",
        "symfony/twig-bundle": ">=7.2"
    },
    "suggest": {
        "mpdf/mpdf": "Required by the MpdfGenerator"
    },
    "require-dev": {
        "rector/rector": "^2.0",
        "mpdf/mpdf": "^8.2",
        "symfony/test-pack": "^1.2",
        "phpunit/phpunit": "^13.0"
    }
}
